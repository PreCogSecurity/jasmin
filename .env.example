# Environment variables for Jasmin SMS Gateway
# Copy this file to .env and fill in actual values
# Never commit actual secrets to version control

# AMQP/RabbitMQ connection
JASMIN_RABBITMQ_HOST=127.0.0.1
JASMIN_RABBITMQ_PORT=5672
JASMIN_RABBITMQ_VHOST=/
JASMIN_RABBITMQ_USERNAME=guest
JASMIN_RABBITMQ_PASSWORD=guest

# Redis connection
JASMIN_REDIS_HOST=127.0.0.1
JASMIN_REDIS_PORT=6379
JASMIN_REDIS_USERNAME=guest
JASMIN_REDIS_PASSWORD=guest

# MySQL connection
JASMIN_MYSQL_HOST=127.0.0.1
JASMIN_MYSQL_USER=jasmin
JASMIN_MYSQL_PASSWORD=your_mysql_password
JASMIN_MYSQL_DATABASE=jasmin